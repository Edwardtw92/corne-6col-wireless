#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        // Double-tap D to delete line (prevents accidental deletes)
        td_dd: tap_dance_dd {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&vim_dd>;
        };
        // Double-tap G for top of file (gg)
        td_gg: tap_dance_gg {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&kp LC(HOME)>;
        };
        // Double-tap G = gg (top), Shift + G = G (bottom)
        vim_g: vim_g {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_gg>, <&kp LC(END)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Double-tap G on Visual layer = highlight to top of file
        td_vis_gg: tap_dance_vis_gg {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&kp LS(LC(HOME))>;
        };
        // Double-tap G = select to top, Shift + G = select to bottom
        vis_g: vis_g {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&td_vis_gg>, <&kp LS(LC(END))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        vim_v: vim_v {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&to 6>, <&vim_V>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        vim_yy: vim_yy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp HOME &kp LS(END) &kp LC(C) &kp RIGHT>;
        };
        vim_o: vim_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp END &kp RET &to 0>;
        };
        vim_t: vim_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp RIGHT &to 0>;
        };
        vim_dd: vim_dd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp HOME &kp LS(END) &kp LC(X) &kp DEL>;
        };
        vim_V: vim_V {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp HOME &kp LS(END) &to 6>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_bt_clr {
            timeout-ms = <50>;
            key-positions = <0 11>;
            layers = <4>;
            bindings = <&bt BT_CLR>;
        };
    };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  F  |  P  |  B  ||       ||  J  |  L   |  U  |  Y  |  ;  |  -  |
// | BKSP |  A  |  R  |  S  |  T  |  G  ||       ||  M  |  N   |  E  |  I  |  O  |  '  |
// |  VIM |  Z  |  X  |  C  |  D  |  V  ||       ||  K  |  H   |  ,  |  .  |  /  |  =  |
//                    | NAV | WM  | Ms  ||       || ESC | SPC  | ENT |
                        display-name = "Base";
                        bindings = <
   &kp TAB         &kp Q       &kp W       &kp F        &kp P        &kp B       &kp J     &kp L        &kp U        &kp Y       &kp SEMI    &kp MINUS
   &hml LSHFT BSPC &hml LGUI A &hml LALT R &hml LCTRL S &hml LSHFT T &kp G       &kp M     &hmr RSHFT N &hmr RCTRL E &hmr RALT I &hmr RGUI O &kp SQT
   &to 5           &kp Z       &kp X       &kp C        &kp D        &kp V       &kp K     &kp H        &kp COMMA    &kp DOT     &kp FSLH    &kp EQUAL
                                           &mo 1        &mo 2        &mo 3       &lt 4 ESC &kp SPACE    &kp RET
                        >;
                };

                nav_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  C-TAB |  1  |  2  |  3  |   4  |  5  ||       ||  6  |  7  |  8  |  9  |   0  |  `  |
// | C-BKSP | VIM |     | SYM | SHFT |     ||       || LFT | DWN |  UP | RGT | SHFT |  \  |
// | C-SHFT |     |     |     |      |     ||       ||     |     |     |     |      |  ~  |
//                      |     |      |     ||       || ESC | VIM | VIM |
                        display-name = "Nav";
                        bindings = <
   &kp LC(TAB)   &kp N1 &kp N2 &kp N3 &kp N4    &kp N5       &kp N6  &kp N7   &kp N8 &kp N9    &kp N0    &kp GRAVE
   &kp LC(BSPC)  &mo 5  &trans &mo 4  &kp LSHFT &trans       &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp LSHFT &kp BSLH
   &kp LC(LSHFT) &trans &trans &trans &trans    &trans       &trans  &trans   &trans &trans    &trans    &kp TILDE
                               &trans &trans    &trans       &kp ESC &mo 5    &mo 5
                        >;
                };

                wm_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// | G-TAB | W-1 | W-2 | W-3 |  W-4 | W-5 ||       || W-6 | W-7 | W-8 | W-9 | W-10 |     |
// |  CTRL |     | W-F |     | SHFT |     ||       || W-L | W-D | W-U | W-R |  W-O |     |
// |  SHFT |     |     |     |      |     ||       ||     | W-M |     |     |      |     |
//                     |     |      |     ||       ||     | VIM | VIM |
                        display-name = "Wm";
                        bindings = <
   &kp LG(TAB) &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)       &kp LG(N6) &kp LG(N7) &kp LG(N8) &kp LG(N9) &kp LG(N0) &trans
   &kp LCTRL   &trans     &kp LG(F)  &trans     &kp LSHFT  &trans           &kp LG(M)  &kp LG(N)  &kp LG(E)  &kp LG(I)  &kp LG(O)  &trans
   &kp LSHFT   &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                     &trans     &trans     &trans           &trans     &mo 5      &mo 5
                        >;
                };

                mouse_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB |  F1 |    F2 |  F3  |  F4  |  F5 ||       ||  F6  |  F7  |  F8  |  F9  | F10 |  VOL + |
// | CTRL | F11 |    BK | CTRL |  FW  | F12 ||       ||  M-L |  M-D |  M-U |  M-R |     |  MUTE  |
// | SHFT |     | PAUSE | Br_U | Br_D |     ||       || Sc-L | Sc-D | Sc-U | Sc-R |     |  VOL - |
//                      |      |      |     ||       || MCLK | RCLK | LCLK |
                        display-name = "Mouse";
                        bindings = <
   &kp TAB   &kp F1  &kp F2    &kp F3       &kp F4       &kp F5        &kp F6         &kp F7         &kp F8       &kp F9          &kp F10 &kp C_VOL_UP
   &kp LCTRL &kp F11 &mkp MB4  &kp LCTRL    &mkp MB5     &kp F12       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &trans  &kp C_MUTE
   &kp LSHFT &trans  &kp C_PP  &kp C_BRI_UP &kp C_BRI_DN &trans        &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &trans  &kp C_VOL_DN
                               &trans       &trans       &trans        &mkp MCLK      &mkp RCLK      &mkp LCLK
                        >;
                };

                sym_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |   $  |  %  ||       ||  ^  |  &  |  *  |  (  |  )  | CAPS |
// | CTRL |     |     |     | SHFT |     ||       ||  -  |  =  |  [  |  ]  |  `  |  \   |
// | SHFT |     |     |     |      |     ||       ||  _  |  +  |  {  |  }  | "|" |  ~   |
//                    |     |      |     ||       ||     |     |     |
                        display-name = "Sym";
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR  &kp PRCNT       &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR  &kp CAPS
   &kp LCTRL &to 5    &trans &trans   &kp LSHFT &trans          &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp GRAVE &kp BSLH
   &kp LSHFT &trans   &trans &trans   &trans    &trans          &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE  &kp TILDE
                    	     &trans   &trans    &trans          &trans    &trans    &trans
                        >;
                };

                vim_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB |     |  dw  |      |  V$  |     ||       ||      |   Vl |  Vu  | Vyy | V0 | CAPS |
// | BKSP | VIS |      | BASE | APND |  Vg ||       ||  LFT |  DWN |  UP  | RGT | Vo |  V$  |
// | SHFT |  UD |      |  CP  |  CUT | PST ||       ||      | PGDN | PGUP | REP |    |   `  |
//                     |      |      |     ||       || BASE |     | ENT |
                        display-name = "Vim";
                        bindings = <
   &kp TAB   &trans    &kp LC(DEL)   &trans    &kp END   &trans          &trans   &kp LC(LEFT) &kp LC(RIGHT) &vim_yy     &kp HOME &kp CAPS
   &kp BSPC  &vim_v    &trans        &to 0     &vim_t    &vim_g          &kp LEFT &kp DOWN     &kp UP        &kp RIGHT   &vim_o   &kp END
   &kp LSHFT &kp LC(Z) &trans        &kp LC(C) &kp LC(X) &kp LC(V)       &trans   &kp PG_DN    &kp PG_UP     &key_repeat &trans   &kp GRAVE
                                     &trans    &trans    &trans          &to 0    &trans       &kp RET
                        >;
                };

                visual_layer {
// ----------------------------------------------------------------------------------------------------------------------------------------------------------------------
// | BASE |    |    |      |  V$  |     ||       ||     |   Vl |  Vu  |     | V0 |      |
// | BASE |    |    | BASE | APND |  Vg ||       || LFT |  DWN |  UP  | RGT |    |  V$  |
// | SHFT | UD |    |  CP  |  CUT | PST ||       ||     | PGDN | PGUP | REP |    |   `  |
//                  |      |      |     ||       || ESC |      | ENT |
                        display-name = "Visual";
                        bindings = <
   &to 5     &trans    &trans &trans    &kp LS(END) &trans          &trans       &kp LS(LC(LEFT)) &kp LS(LC(RIGHT)) &trans        &kp LS(HOME) &kp CAPS
   &to 5     &trans    &trans &to 0     &vim_t      &vis_g          &kp LS(LEFT) &kp LS(DOWN)     &kp LS(UP)        &kp LS(RIGHT) &vim_o       &kp LS(END)
   &kp LSHFT &kp LC(Z) &trans &kp LC(C) &kp LC(X)   &kp LC(V)       &trans       &kp LS(PG_DN)    &kp LS(PG_UP)     &trans        &trans       &kp GRAVE
                              &trans    &trans      &trans          &to 0        &trans           &kp RET
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
